{
  "name": "hub-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "cd .. && cargo run -q -p hub-server -- --openapi > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@observablehq/plot": "0.6.17",
    "@sefer/editor": "github:Bible-Translation-Tools/Sefer#editor-v0.1.0&path:packages/editor",
    "@sefer/text": "github:Bible-Translation-Tools/Sefer#editor-v0.1.0&path:packages/text",
    "@solidjs/router": "1.0.0",
    "@wycliffeassociates/scripture-kitchen": "github:WycliffeAssociates/scripture-kitchen#v0.1.10",
    "effect": "4.0.0-rc.112",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14"
  }
}
