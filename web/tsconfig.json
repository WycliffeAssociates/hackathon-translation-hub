{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@viewer/*": ["../spikes/viewer/src/*"],
      "#core/*": ["../spikes/viewer/src/host/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../spikes/viewer/src/viewer/virtual.d.ts"]
}
